<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
    <meta charset="UTF-8">
</head>
<body style="font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px; margin: 0 auto; padding: 20px;">
    <h1 style="color: #2c3e50;">{{ 'app.email.translation_outdated_heading'|trans({'%label%': label, '%locale%': targetLocale}, 'messages', locale) }}</h1>

    <p>{{ 'app.email.translation_outdated_body'|trans({'%label%': label, '%locale%': targetLocale}, 'messages', locale) }}</p>

    <p style="margin: 24px 0;">
        <a href="{{ editorUrl }}" style="background-color: #b8860b; color: #fff; padding: 10px 18px; text-decoration: none; border-radius: 4px;">
            {{ 'app.email.translation_open_button'|trans({}, 'messages', locale) }}
        </a>
    </p>
</body>
</html>
